<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F9FF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- App Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WanHaziq Bill Calculator"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#0D47A1"
            android:gravity="center"
            android:layout_marginBottom="10dp" />

        <!-- Instruction -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select a month, enter electricity usage between 1 and 1000 kWh, choose rebate percentage, then tap Calculate Bill."
            android:textSize="15sp"
            android:textColor="#333333"
            android:background="#E3F2FD"
            android:padding="12dp"
            android:layout_marginBottom="18dp" />

        <!-- Month Label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Month"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <!-- Month Spinner -->
        <Spinner
            android:id="@+id/spinnerMonth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- Unit Label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Electricity Unit Used (kWh)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <!-- Unit Input -->
        <EditText
            android:id="@+id/editTextUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Enter unit from 1 to 1000"
            android:inputType="number"
            android:padding="12dp"
            android:backgroundTint="#1976D2"
            android:layout_marginBottom="16dp" />

        <!-- Rebate Label -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Rebate Percentage"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000" />

        <!-- Rebate Value -->
        <TextView
            android:id="@+id/textRebateValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selected Rebate: 0%"
            android:textSize="15sp"
            android:textColor="#333333"
            android:layout_marginBottom="6dp" />

        <!-- Rebate Slider -->
        <SeekBar
            android:id="@+id/seekBarRebate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="5"
            android:progress="0"
            android:layout_marginBottom="20dp" />

        <!-- Calculate Button -->
        <Button
            android:id="@+id/buttonCalculate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calculate Bill"
            android:textSize="16sp"
            android:drawableStart="@drawable/ic_calculate"
            android:drawablePadding="8dp"
            android:backgroundTint="#1976D2"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="18dp" />

        <!-- Result Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="18dp">

            <TextView
                android:id="@+id/textTotalCharges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total Charges: RM 0.00"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/textFinalCost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Final Cost After Rebate: RM 0.00"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#0D47A1" />

        </LinearLayout>

        <!-- Save Button -->
        <Button
            android:id="@+id/buttonSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Save Record"
            android:textSize="16sp"
            android:backgroundTint="#2E7D32"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <!-- History Button -->
        <Button
            android:id="@+id/buttonViewHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="View History"
            android:textSize="16sp"
            android:drawableStart="@drawable/ic_history"
            android:drawablePadding="8dp"
            android:backgroundTint="#1565C0"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="10dp" />

        <!-- About Button -->
        <Button
            android:id="@+id/buttonAbout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="About App"
            android:textSize="16sp"
            android:drawableStart="@drawable/ic_info"
            android:drawablePadding="8dp"
            android:backgroundTint="#455A64"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>